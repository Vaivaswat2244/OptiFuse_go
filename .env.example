# Copy to .env and fill in. .env is gitignored and excluded from Docker build
# contexts via .dockerignore.

# ── Gateway ───────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://optifuse:secretpassword@db:5432/optifuse_db?sslmode=disable

# GitHub OAuth app credentials (Settings → Developer settings → OAuth Apps)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Origin allowed by CORS — where the Next.js frontend is served from
CLIENT_ORIGIN_URL=http://localhost:3000

# ── Enricher ──────────────────────────────────────────────────────────────────
# These must belong to the OptiFuse *service* account — the account named as the
# principal in customers' CloudFormation trust policies. Assuming a customer role
# is itself an AWS call, so the enricher has to authenticate as OptiFuse before it
# can borrow their role. Keys from any other account fail with an AccessDenied
# that names sts:AssumeRole and looks like a customer misconfiguration.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Must match the region the customer's Lambdas run in, or every CloudWatch query
# returns nothing and every function reports as missing telemetry.
AWS_REGION=ap-south-1

# ── All services (optional) ───────────────────────────────────────────────────
# LOG_LEVEL=info      # debug | info | warn | error
# LOG_FORMAT=json     # json for log aggregators; text otherwise
# METRICS_PORT=9090
